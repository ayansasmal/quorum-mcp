{
  "name": "@as-quorum/mcp",
  "version": "0.0.1",
  "description": "Quorum MCP server — governed engineering memory for Claude Code and AI agents",
  "type": "module",
  "license": "Elastic-2.0",
  "author": "Ayan Sasmal",
  "homepage": "https://github.com/ayansasmal/quorum-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayansasmal/quorum-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ayansasmal/quorum-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agents",
    "knowledge-management",
    "governance",
    "quorum"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "quorum-mcp": "./dist/server.js",
    "quorum": "./dist/cli.js"
  },
  "exports": {
    "./config/schema": "./src/config/schema.js",
    "./graph/queries": "./src/graph/queries.js",
    "./graph/client": "./src/graph/client.js",
    "./audit/secondary": "./src/audit/secondary.js",
    "./audit/chain": "./src/audit/chain.js",
    "./governance/constitutional": "./src/governance/constitutional.js",
    ".": "./dist/server.js"
  },
  "files": [
    "dist/",
    "src/",
    "cli.js",
    "skill/",
    "hooks/"
  ],
  "scripts": {
    "build": "esbuild src/server.js --bundle --platform=node --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/server.js",
    "build:cli": "esbuild cli.js --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "build:all": "npm run build && npm run build:cli",
    "dev": "node --watch src/server.js",
    "start": "node dist/server.js",
    "setup": "node dist/cli.js install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:constitutional": "vitest run tests/constitutional",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.js",
    "test:integration:docker": "docker compose -f ../quorum/docker-compose.e2e.yml run --rm mcp-test-runner",
    "prepublishOnly": "npm run build:all",
    "prepare": "husky || true",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:patch": "commit-and-tag-version --release-as patch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "uuid": "^14.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "commit-and-tag-version": "^12.7.3",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "vitest": "4.1.2"
  }
}
