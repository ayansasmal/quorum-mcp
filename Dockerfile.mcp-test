# =============================================================================
# Dockerfile.mcp-test — MCP integration test runner
#
# PURPOSE
#   Runs quorum-mcp integration tests (Vitest) inside an isolated Alpine
#   container, connected to the quorum-e2e Docker network so tests reach
#   the live gateway at http://gateway:3001.
#
# NODE_MODULES STRATEGY (mirrors Dockerfile.e2e in quorum/)
#   1. npm ci during build → /workspace/quorum-mcp/node_modules in image layer
#   2. At runtime, qc/ parent is bind-mounted at /workspace (host files overlay)
#   3. Anonymous volume at /workspace/quorum-mcp/node_modules shadows the host
#      macOS binaries with the Alpine-compiled ones from the image layer
#
# RELATIVE IMPORT RESOLUTION
#   tests/integration/helpers/tokens.js imports:
#     ../../../../quorum/e2e/helpers/jwt.js
#   With qc/ mounted at /workspace:
#     /workspace/quorum-mcp/tests/integration/helpers/ → up 4 levels → /workspace/
#     /workspace/quorum/e2e/helpers/jwt.js  ✓
#   jwt.js then readFileSync('../fixtures/test-private-key.pem') relative to its
#   own location → /workspace/quorum/e2e/fixtures/test-private-key.pem ✓
#
# USAGE
#   npm run test:e2e:mcp           # from quorum/ — run MCP integration tests
#   docker compose -f ../quorum/e2e/docker-compose.yml run --rm mcp-test-runner
# =============================================================================

FROM node:24-alpine
ENV NODE_ENV=test

WORKDIR /workspace/quorum-mcp

# Install node_modules into the image layer.
# Only package manifests are copied — application source is bind-mounted at runtime.
# This layer is cached and only rebuilt when package.json / package-lock.json changes.
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

CMD ["npm", "run", "test:integration"]
